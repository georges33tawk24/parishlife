@using Microsoft.AspNetCore.Identity
@using ParishLive.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" style="display:inline">
        <a asp-area="Identity" asp-page="/Account/Manage/Index">@(User.Identity?.Name)</a>
        <button type="submit">@L["Account.SignOut"]</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">@L["Account.SignIn"]</a>
}
