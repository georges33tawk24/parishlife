@using System.Globalization
@using ParishLive.Application.Abstractions
@using ParishLive.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ITenantContext Tenant
@inject AppDbContext Db
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@{
    var culture = CultureInfo.CurrentUICulture;
    var lang = culture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var name = User.FindFirst(PlClaims.Name)?.Value ?? User.Identity?.Name ?? "";
    var role = Tenant.ActingRole;
    var parish = Tenant.ParishIds.Count == 1 ? await Db.Parishes.Where(p => p.Id == Tenant.ParishIds.Single()).Select(p => p.Name).FirstOrDefaultAsync() : null;
    var organization = Tenant.OrgId != Guid.Empty ? await Db.Organizations.Where(o => o.Id == Tenant.OrgId).Select(o => o.Name).FirstOrDefaultAsync() : null;
    var office = role is "Priest" or "Secretary" or "ParishAdmin" or "ArchdioceseAdmin";
    var finance = role is "Treasurer" or "FinanceViewer";
}
<!DOCTYPE html>
<html lang="@lang" dir="@(culture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · ParishLife</title>
<link rel="stylesheet" href="~/css/parishlive.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">@L["Common.Skip"]</a>
<div class="app">
<aside class="spine">
  <div class="brand"><span class="wm">Parish<b>Life</b></span></div>
  <a class="ctx" href="/Context/Choose"><span class="ct"><span class="cp">@(parish ?? organization ?? L["Context.NoAssignment"].Value)</span><span class="cr">@(role is null ? L["Context.Choose"] : L["SysRole." + role])</span></span></a>
  <nav aria-label="@L["Common.Navigation"]">
    <a class="ni" href="/"><span class="nl">@L["Nav.Dashboard"]</span></a>
    <a class="ni" href="/Requests"><span class="nl">@L["Nav.Requests"]</span></a>
    @if (role is not null)
    {
      <a class="ni" href="/Events/Calendar"><span class="nl">@L["Events.Calendar"]</span></a>
      <a class="ni" href="/Reservations"><span class="nl">@L["Nav.Reservations"]</span></a>
      <a class="ni" href="/Community"><span class="nl">@L["Nav.Groups"]</span></a>
      <a class="ni" href="/Events"><span class="nl">@L["Nav.Events"]</span></a>
    }
    @if (office)
    {
      <a class="ni" href="/People/Records"><span class="nl">@L["Nav.Members"]</span></a>
      <a class="ni" href="/Publishing"><span class="nl">@L["Nav.Website"]</span></a>
      <a class="ni" href="/Finance?officeOnly=true"><span class="nl">@L["Nav.OfficeExpenses"]</span></a>
      <a class="ni" href="/Audit"><span class="nl">@L["Nav.Audit"]</span></a>
    }
    @if (finance) { <a class="ni" href="/Finance"><span class="nl">@L["Nav.Finance"]</span></a> }
    <a class="ni" href="/Private"><span class="nl">@L["Nav.Notes"]</span></a>
    <a class="ni" href="/Concerns"><span class="nl">@L["Concern.Title"]</span></a>
    <a class="ni" href="/Notifications"><span class="nl">@L["Bar.Notifications"]</span></a>
    <a class="ni" href="/Public/Directory"><span class="nl">@L["Public.Discover"]</span></a>
    <a class="ni" href="/Readiness"><span class="nl">@L["Nav.Readiness"]</span></a>
    <a class="ni" href="/Recovery"><span class="nl">@L["Recovery.Title"]</span></a>
    <a class="ni" href="/Administration"><span class="nl">@L["Admin.Title"]</span></a>
  </nav>
  <div class="who"><span class="wt"><span class="wn">@name</span><span class="wr">@(role is null ? "" : L["SysRole." + role])</span></span></div>
</aside>
<div class="main">
  <header class="bar">
    <div class="crumbs"><b>@ViewData["Title"]</b></div>
    <div class="acts">
      @foreach (var language in new[] { ("en", "English"), ("fr", "Français"), ("ar", "العربية") })
      { <a class="lang" data-language-link lang="@language.Item1" aria-current="@(lang == language.Item1 ? "true" : null)" href="/set-culture?culture=@language.Item1&returnUrl=@Uri.EscapeDataString(returnUrl)">@language.Item2</a> }
      <partial name="_LoginPartial" />
      <button type="button" id="themeBtn" class="btn btn-g">@L["Bar.Theme"]</button>
    </div>
  </header>
  @if (HostEnvironment.IsDevelopment() || HostEnvironment.IsEnvironment("Testing")) { <p class="demo-banner" role="note">@L["Common.Demo"]</p> }
  @RenderBody()
</div>
</div>
<dialog id="draft-dialog" data-failure="@L["Draft.SaveFailed"]" aria-labelledby="draft-dialog-title"><h2 id="draft-dialog-title">@L["Draft.Unsaved"]</h2><p>@L["Draft.SwitchHelp"]</p><p id="draft-failure" role="alert"></p><div class="ops-row"><button type="button" data-draft-choice="save" class="btn btn-p">@L["Common.SaveDraft"]</button><button type="button" data-draft-choice="discard" class="btn btn-g">@L["Draft.Discard"]</button><button type="button" data-draft-choice="stay" class="btn btn-g">@L["Draft.Stay"]</button></div></dialog>
<script src="~/js/operations.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
