@page
@model ParishLive.Web.Pages.Finance.GivingModel
@{ ViewData["Title"] = L["Giving.Title"].Value; }
<main class="content" id="main-content"><a href="/Finance">@L["Common.Back"]</a><h1>@L["Giving.Title"]</h1><p>@L["Giving.Help"]</p>
@if (Model.Error is not null) { <div class="ops-error" role="alert">@L[Model.Error]</div> }
@if (Model.CanWrite) { <form method="post" class="ops-form ops-card"><input type="hidden" asp-for="OperationId" /><label>@L["Finance.Source"]<input name="source" required maxlength="200" /></label><label>@L["Giving.CollectedAt"] (UTC)<input name="collectedAt" type="datetime-local" required /></label><button name="action" value="Open" class="btn btn-p">@L["Giving.Open"]</button></form> }
@foreach (var batch in Model.Batches) { <section class="ops-card"><h2>@batch.SourceReference</h2><p>@L["Giving.Status." + batch.Status] · @L["Common.Revision"] @batch.Revision · @batch.CollectedAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'")</p><ul>@foreach (var line in Model.Lines.GetValueOrDefault(batch.Id) ?? []) { <li><bdi>@(line.Currency == "USD" ? line.Units / 100m : line.Units) @line.Currency</bdi> · @line.Fund</li> }</ul>
@if (Model.CanWrite && batch.Status != "Closed") { <form method="post" class="ops-form"><input type="hidden" name="id" value="@batch.Id" /><input type="hidden" name="revision" value="@batch.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><label>@L["Finance.Amount"]<input name="amount" type="number" step="0.01" min="0.01" required /></label><label>@L["Finance.Currency"]<select name="currency"><option>USD</option><option>LBP</option></select></label><label>@L["Finance.Fund"]<input name="fund" required maxlength="200" /></label><button name="action" value="Line" class="btn btn-g">@L["Giving.AddLine"]</button></form>
<form method="post" class="ops-form"><input type="hidden" name="id" value="@batch.Id" /><input type="hidden" name="revision" value="@batch.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><p>@L["Giving.Independent"]</p><label>@L["Giving.UsdCents"]<input name="observedUsdCents" type="number" step="1" min="0" /></label><label>@L["Giving.LbpUnits"]<input name="observedLbp" type="number" step="1" min="0" /></label><button name="action" value="Verify" class="btn btn-g">@L["Giving.Verify"]</button></form>
@if (batch.Status == "Verified") { <form method="post"><input type="hidden" name="id" value="@batch.Id" /><input type="hidden" name="revision" value="@batch.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><button class="btn btn-p" name="action" value="Close" data-confirm="@L["Giving.CloseConfirm"]">@L["Giving.Close"]</button></form> } }
</section> }
</main>
