@page
@model ParishLive.Web.Pages.Finance.IndexModel
@using ParishLive.Domain.Entities
@{ ViewData["Title"] = L[Model.OfficeOnly ? "Nav.OfficeExpenses" : "Nav.Finance"].Value; }
<main class="content" id="main-content"><h1>@ViewData["Title"]</h1><p>@L["Finance.ScopeHelp"]</p>
<p><a asp-page-handler="Export" asp-route-OfficeOnly="@Model.OfficeOnly">@L["Finance.ExportAll"]</a> · <a href="/Finance/Giving">@L["Giving.Title"]</a></p>
@if (Model.Error is not null) { <div class="ops-error" role="alert">@L[Model.Error]</div> }
<div class="ops-grid">@foreach (var balance in Model.Summary.Balances) { <article class="ops-card"><h2><bdi>@balance.Key</bdi></h2><p><bdi>@(balance.Key.EndsWith("USD") ? (balance.Value / 100m).ToString("N2") : balance.Value.ToString("N0"))</bdi></p></article> }</div>
@if (Model.Summary.Balances.Count == 0) { <p>@L["Finance.NoBalances"]</p> }
<p class="ops-hint">@L["Common.AsOf"] @Model.Summary.AsOfUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
<h2>@L["Finance.Requests"]</h2>
@foreach (var request in Model.Requests)
{ <section class="ops-card"><p><bdi>@request.SourceReference</bdi> · @L["Movement." + request.Kind] · <bdi>@(request.Currency == "USD" ? request.Units / 100m : request.Units) @request.Currency</bdi> · @L["Finance." + request.Status]</p>
@if (Model.CanApprove && request.Status == "Submitted") { <form method="post"><input type="hidden" name="OfficeOnly" value="@Model.OfficeOnly" /><input type="hidden" name="id" value="@request.Id" /><input type="hidden" name="revision" value="@request.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><button class="btn btn-g" name="action" value="Approve" data-confirm="@L["Finance.ConfirmApproval"]">@L["Btn.Approve"]</button></form> }
@if (Model.CanWrite && request.Status == "Approved") { <form method="post" class="ops-form"><input type="hidden" name="OfficeOnly" value="@Model.OfficeOnly" /><input type="hidden" name="id" value="@request.Id" /><input type="hidden" name="revision" value="@request.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><label>@L["Finance.ActualEvidence"]<input name="actualEvidence" required maxlength="500" /></label><label>@L["Finance.ActualAt"] (UTC)<input name="actualAt" type="datetime-local" required /></label><button class="btn btn-p" name="action" value="Pay" data-confirm="@L["Finance.ConfirmActual"]">@L["Finance.RecordPayment"]</button></form> }
</section> }
@if (Model.CanWrite)
{ <h2>@L["Finance.NewRequest"]</h2><form method="post" class="ops-form" data-track-changes><input type="hidden" asp-for="OperationId" /><input type="hidden" asp-for="OfficeOnly" />
<div><label asp-for="Kind">@L["Finance.Kind"]</label><select asp-for="Kind">@foreach (var kind in Model.OfficeOnly ? new[] { MovementKind.Expense, MovementKind.Opening } : new[] { MovementKind.Expense, MovementKind.Transfer, MovementKind.Opening }) { <option value="@kind">@L["Movement." + kind]</option> }</select></div>
<div><label asp-for="Amount">@L["Finance.Amount"] *</label><input asp-for="Amount" type="number" min="0.01" step="0.01" required /></div><div><label asp-for="Currency">@L["Finance.Currency"]</label><select asp-for="Currency"><option>USD</option><option>LBP</option></select></div>
@if (!Model.OfficeOnly) { <div><label asp-for="Account">@L["Finance.Account"] *</label><input asp-for="Account" required maxlength="100" /></div><div><label asp-for="DestinationAccount">@L["Finance.Destination"]</label><input asp-for="DestinationAccount" maxlength="100" /></div> }
<div><label asp-for="Fund">@L["Finance.Fund"] *</label><input asp-for="Fund" required maxlength="200" /></div><div><label asp-for="SourceReference">@L["Finance.Source"] *</label><input asp-for="SourceReference" required maxlength="200" /></div><button class="btn btn-p" name="action" value="Submit">@L["Finance.Submit"]</button></form> }
@if (Model.CanApprove && !Model.OfficeOnly) { <section class="ops-card"><h2>@L["Finance.ActualReceipt"]</h2><p>@L["Finance.ReceiptHelp"]</p><form method="post" class="ops-form"><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><label>@L["Finance.Amount"]<input name="Amount" type="number" step="0.01" min="0.01" required /></label><label>@L["Finance.Currency"]<select name="Currency"><option>USD</option><option>LBP</option></select></label><label>@L["Finance.Account"]<input name="Account" required maxlength="100" /></label><label>@L["Finance.Fund"]<input name="Fund" required maxlength="200" /></label><label>@L["Finance.Source"]<input name="SourceReference" required maxlength="200" /></label><label>@L["Finance.Method"]<select name="method"><option value="Cash">@L["Finance.Method.Cash"]</option><option value="VerifiedBank">@L["Finance.Method.VerifiedBank"]</option><option value="VerifiedOMT">@L["Finance.Method.VerifiedOMT"]</option></select></label><label>@L["Finance.ActualAt"] (UTC)<input name="actualAt" type="datetime-local" required /></label><button name="action" value="Receive" class="btn btn-p" data-confirm="@L["Finance.ConfirmActual"]">@L["Finance.ActualReceipt"]</button></form></section> }
<h2>@L["Finance.Posted"]</h2><div class="table-scroll"><table class="ops-table"><thead><tr><th>@L["Finance.Source"]</th><th>@L["Finance.ActualAt"]</th><th>@L["Finance.Kind"]</th><th>@L["Finance.Amount"]</th><th>@L["Finance.Account"]</th></tr></thead><tbody>@foreach (var movement in Model.Movements.OrderByDescending(m => m.ActualAtUtc)) { <tr><td><bdi>@movement.SourceReference</bdi></td><td>@movement.ActualAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td><td>@L["Movement." + movement.Kind]</td><td><bdi>@(movement.Currency == "USD" ? movement.Units / 100m : movement.Units) @movement.Currency</bdi></td><td>@movement.Account @if (movement.DestinationAccount is not null) { <span>→ @movement.DestinationAccount</span> }</td></tr> }</tbody></table></div>
</main>
