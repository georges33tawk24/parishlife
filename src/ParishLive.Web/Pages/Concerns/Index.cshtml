@page
@model ParishLive.Web.Pages.Concerns.IndexModel
@{ ViewData["Title"] = L["Concern.Title"].Value; }
<main class="content" id="main-content"><h1>@L["Concern.Title"]</h1><p>@L["Concern.Privacy"]</p><p class="ops-status">@L["Concern.Urgent"]</p>
@if (Model.Error is not null) { <div class="ops-error" role="alert">@L[Model.Error]</div> }
@if (Model.Reviewers.Count > 0) { <form method="post" class="ops-form ops-card" data-track-changes><input type="hidden" asp-for="OperationId" /><label asp-for="Narrative">@L["Concern.Narrative"]</label><textarea asp-for="Narrative" required maxlength="10000" dir="auto"></textarea><label><input asp-for="Anonymous" />@L["Concern.Anonymous"]</label><label><input asp-for="Sensitive" />@L["Concern.Sensitive"]</label><fieldset><legend>@L["Concern.ChooseReviewers"]</legend>@foreach (var reviewer in Model.Reviewers) { <label><input type="checkbox" name="ReviewerIds" value="@reviewer.Id" />@reviewer.Name · @L[reviewer.Sensitive ? "Concern.SensitiveEligible" : "Concern.OrdinaryEligible"]</label> }</fieldset><button class="btn btn-p">@L["Case.Submit"]</button></form> }
else { <p class="ops-status">@L["Concern.NoRoute"]</p> }
@foreach (var item in Model.Items) { <article class="ops-card"><h2>@L["Concern.Status." + item.Status]</h2><p class="ops-draft" dir="auto">@item.Narrative</p><p>@L[item.SubmitterUserId is null ? "Concern.IdentityHidden" : "Concern.IdentityPermitted"]</p><ol>@foreach (var message in Model.Messages.GetValueOrDefault(item.Id) ?? []) { <li>@message.At.ToString("yyyy-MM-dd HH:mm 'UTC'")<p dir="auto">@message.Reply</p>@if (message.ReviewerNote is not null) { <p class="ops-hint">@L["Concern.ReviewerNote"]: @message.ReviewerNote</p> }</li> }</ol>
@if (Model.IsReviewer) { <form method="post" asp-page-handler="Review" class="ops-form"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="revision" value="@item.Revision" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" /><label>@L["Concern.ApplicantReply"]<textarea name="reply" maxlength="2000" dir="auto"></textarea></label><label>@L["Concern.ReviewerNote"]<textarea name="note" maxlength="2000" dir="auto"></textarea></label><div class="actions"><button class="btn btn-g" name="action" value="Start">@L["Concern.Start"]</button><button class="btn btn-p" name="action" value="Reply">@L["Concern.Reply"]</button><button class="btn btn-g" name="action" value="Recuse" data-confirm="@L["Concern.RecuseHelp"]">@L["Concern.Recuse"]</button><button class="btn btn-g" name="action" value="Close">@L["Concern.Close"]</button><button class="btn btn-g" name="action" value="Reopen">@L["Concern.Reopen"]</button></div></form> }</article> }
</main>
