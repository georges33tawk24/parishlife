@page
@model ErrorModel
@{
    ViewData["Title"] = L["Failure.Title"].Value;
}

<main class="content" id="main-content"><h1>@L["Failure.Title"]</h1>
<p class="ops-error" role="alert">@L["Failure.Help"]</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Failure.Reference"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<p><a href="/Recovery">@L["Recovery.Title"]</a> · <a href="/">@L["Nav.Dashboard"]</a> · <a href="/Public/Directory">@L["Public.Directory"]</a></p></main>
