{
  "name": "parishlife-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The ParishLife frontend in React: the public site (public.html), the members portal and sign-in (index.html) and the product page (landing.html).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "check": "node scripts/run-checks.mjs",
    "check:routes": "node scripts/check-routes.mjs --strict",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx}\" vite.config.js playwright.config.mjs scripts e2e",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" vite.config.js playwright.config.mjs scripts e2e",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.10.1",
    "vite": "7.3.8"
  },
  "overrides": {
    "axe-core": "4.14.0"
  }
}
