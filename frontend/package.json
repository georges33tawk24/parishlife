{
  "name": "parishlife-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The ParishLife frontend in React: the public site (public.html), the members portal and sign-in (index.html) and the product page (landing.html).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-api.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx}\" vite.config.js scripts",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" vite.config.js scripts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
