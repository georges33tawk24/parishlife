<!-- Purpose: builds the single production API, including services, models, persistence, and Azure integration.
     Main contents: .NET 10 settings and runtime packages; no application-layer or test-project references. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" Version="10.0.14" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageReference Include="Microsoft.OpenTelemetry" Version="1.2.0" />
    <!-- Pin serviced cryptography packages used transitively by Azure/telemetry integrations. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Opt-in single-host deployment: `dotnet publish -p:IncludeFrontend=true` copies the built frontend (run `npm run build` in frontend/
       first) into the publish output's wwwroot, where UseParishLifeFrontend serves it. Without the property the publish stays API-only. -->
  <Target Name="PublishFrontend" AfterTargets="Publish" Condition="'$(IncludeFrontend)' == 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../frontend/dist/index.html')" Text="IncludeFrontend=true needs a built frontend: run npm run build in frontend/." />
    <ItemGroup><FrontendFile Include="$(MSBuildProjectDirectory)/../frontend/dist/**/*" /></ItemGroup>
    <Copy SourceFiles="@(FrontendFile)" DestinationFiles="@(FrontendFile->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
