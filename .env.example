# Purpose: lists every setting the ParishLife API reads, with placeholder values only. Never put a real value in this file.
# How it is used: ASP.NET Core reads these as environment variables ("Section__Key" = "Section:Key"), from App Service settings in
# production and from `dotnet user-secrets` (ParishLife.Api) or launchSettings.json locally. Nothing here reaches the browser except
# Turnstile__SiteKey (public, served by /api/auth/capabilities) and the PublicApp__* manifest fields.
# Secrets (marked SECRET) live only in Key Vault `keyvault-parishlife`; App Service holds a Key Vault reference, never the value.
# Development, production (and a future staging) use separate values: Development defaults to Local storage and needs none of the
# Azure settings; production values are set only in App Service. Startup fails fast on missing or malformed core settings.

# --- Hosting -------------------------------------------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development            # Development | Production
AllowedHosts=localhost                        # production: semicolon-separated host names

# --- Storage (required) --------------------------------------------------------------------------------------------------------
Storage__Provider=Local                       # Local (Development only) | Cosmos
Storage__LocalPath=../.parishlife-data/local  # Local only; git-ignored folder
Cosmos__Endpoint=https://<cosmos-account>.documents.azure.com:443/   # Cosmos only; HTTPS, no key in the URL
Cosmos__Database=ParishLife
Cosmos__EmulatorKey=                          # SECRET; Development emulator only, forbidden elsewhere
Azure__ManagedIdentityClientId=<user-assigned-identity-client-id>   # required in production (identifier, not a secret)
BlobStorage__ServiceUri=https://<storage-account>.blob.core.windows.net/
BlobStorage__EvidenceContainer=evidence

# --- Data Protection key ring (required in production) -----------------------------------------------------------------------
DataProtection__ApplicationName=ParishLife.Production
DataProtection__BlobUri=https://<storage-account>.blob.core.windows.net/<container>/keyring.xml
DataProtection__KeyIdentifier=https://<key-vault>.vault.azure.net/keys/<key-name>    # versionless key URI

# --- Background jobs and passkeys ----------------------------------------------------------------------------------------------
BackgroundJobs__Enabled=false
Passkeys__ServerDomain=                       # optional; defaults to the request host

# --- Cloudflare Turnstile (optional: set both keys or neither) --------------------------------------------------------------
Turnstile__SiteKey=                           # public
Turnstile__SecretKey=                         # SECRET: @Microsoft.KeyVault(SecretUri=https://<key-vault>.vault.azure.net/secrets/turnstile-secret-key/)
Turnstile__ExpectedHostname=                  # optional

# --- Account email through Resend (optional: set all three or none) ---------------------------------------------------------
Email__Provider=                              # Resend
Email__ResendApiKey=                          # SECRET: @Microsoft.KeyVault(SecretUri=https://<key-vault>.vault.azure.net/secrets/resend-api-key/)
Email__From=                                  # ParishLife <no-reply@<verified-domain>>

# --- External sign-in (optional, per provider) -------------------------------------------------------------------------------
ExternalSignIn__google__ClientId=             # public client ID
ExternalSignIn__google__ClientSecret=         # SECRET: @Microsoft.KeyVault(SecretUri=https://<key-vault>.vault.azure.net/secrets/google-client-secret/)
ExternalSignIn__microsoft__ClientId=          # public client ID
ExternalSignIn__microsoft__UseManagedIdentityAssertion=false   # true in production: no Microsoft client secret at all
ExternalSignIn__microsoft__ClientSecret=      # SECRET; leave empty when the managed-identity assertion is used

# --- Public app manifest (optional) -------------------------------------------------------------------------------------------
PublicApp__Name=
PublicApp__ShortName=

# --- Telemetry (optional) ------------------------------------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=        # treat as SECRET; App Service setting only
OTEL_EXPORTER_OTLP_ENDPOINT=                  # set by Aspire locally

# --- Frontend development and tests (never injected into the bundle) --------------------------------------------------------
PARISHLIFE_API=https://localhost:7243         # Vite dev proxy target
E2E_CHANNEL=chromium                          # Playwright browser channel
