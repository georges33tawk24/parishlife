<!-- Purpose: a test-only host for the signed-in browser tests: the real API on Kestrel over HTTPS with isolated local storage,
     the built frontend beside it, and fixture accounts for every role. Never published or deployed.
     Main contents: executable settings, the WebApplicationFactory package and the API reference. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable><IsPublishable>false</IsPublishable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Pin serviced transitive cryptography dependencies; do not suppress audit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../ParishLife.Api/ParishLife.Api.csproj" /></ItemGroup>
</Project>
